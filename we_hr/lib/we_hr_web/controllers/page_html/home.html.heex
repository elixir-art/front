  <h1 class="pl-5 pb-5 md:pl-12 font-serif font-medium text-2xl">Dashboard</h1>
  <div class="lg:grid lg:grid-cols-3">
    <div class="px-5 font-serif grid gap-4 mb-5 md:pl-12 md:grid-cols-3 lg:col-span-2">
      <div class="bg-[#FFEFE7] py-4 pl-5 pr-3 rounded-lg">
        <h2 class="text-lg font-medium">Available Position</h2>
        <p class="text-4xl font-medium my-4">24</p>
        <p class="text-sm text-main">4 Urgently needed</p>
      </div>

      <div class="bg-[#E8F0FB] py-4 pl-5 pr-3 rounded-lg">
        <h2 class="text-lg font-medium">Job Open</h2>
        <p class="text-4xl font-medium my-4">10</p>
        <p class="text-sm text-[#3786F1]">4 Active hiring</p>
      </div>

      <div class="bg-[#FDEBF9] py-4 pl-5 pr-3 rounded-lg">
        <h2 class="text-lg font-medium">New Employees</h2>
        <p class="text-4xl font-medium my-4">24</p>
        <p class="text-sm text-[#EE61CF]">4 Department</p>
      </div>

      <div class="grid gap-4 md:col-span-3 md:grid-cols-2">
        <div class="p-5 border-[#E0E0E0] border rounded-lg md:col-span-1 flex justify-between items-center">
          <div>
            <h2 class="text-lg font-medium mb-5">Total Employees</h2>
            <p class="text-5xl font-medium mb-8">216</p>
            <p class="text-xs text-primarySubtitle mb-1 font-roboto">120 Men</p>
            <p class="text-xs text-primarySubtitle font-roboto">96 Women</p>
          </div>
          <div>
            <img src="images/graph_employees.png" alt="graph employees">
          </div>
        </div>
        <div class="p-5 border-[#E0E0E0] border rounded-lg md:col-span-1 flex justify-between items-center">
          <div>
            <h2 class="text-lg font-medium mb-5">Talent Request</h2>
            <p class="text-5xl font-medium mb-8">16</p>
            <p class="text-xs text-primarySubtitle mb-1 font-roboto">6 Men</p>
            <p class="text-xs text-primarySubtitle font-roboto">10 Women</p>
          </div>
          <div>
            <img src="images/graph_talents.png" alt="graph employees">
          </div>
        </div>
      </div>


      <div class="border-[#E0E0E0] md:col-span-3 border rounded-xl">
        <div class="py-4 px-5">
          <div class="mb-4 flex justify-between items-center">
            <h2 class="text-lg font-medium text-tertiary">Announcement</h2>
            <div class="border border-[#EFEFEF] p-1 pl-2 flex items-center rounded">
              <p class="text-xs font-roboto text-primarySubtitle mr-1">Today, 13 Sep 2021</p>
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 18 19" fill="none">
                <path d="M4 7.5L9 11.5L14 7.5" stroke="#B2B2B2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
          </div>

          <div class="px-4 py-3 bg-[#FAFAFA] rounded-md mb-2">
            <h3 class="text-base font-regular mb-1">Outing schedule for every departement</h3>
            <div class="flex justify-between items-center">
              <div>
                <p class="text-xs text-primarySubtitle font-roboto">5 Minutes ago</p>
              </div>

