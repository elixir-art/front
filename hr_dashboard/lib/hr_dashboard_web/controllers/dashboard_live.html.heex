<div class="flex">
  <!-- left menu -->
  <div
    class="h-full hidden tab:block lap:block font-poppins font-regular text-[16px] text-grey_text bg-grey_bg"
  >
    <p
      class="lap:w-[242px] tab:w-[90px] mt-10 mb-5 text-center font-poppins font-semibold tab:text-[20px] lap:text-[36px] text-black"
    >
      WeHR
    </p>
    <ul class="lap:w-[242px] tab:w-[90px]">
      <li
        class="font-roboto tab:justify-center font-medium-12 opacity-50 py-[10px] lap:pl-[30px] lap:text-left tab:text-center text-[12px] text-grey_text"
      >
        <p class="lap:w-[242px] tab:w-[90px] tab:justify-center">MAIN MENU</p>
      </li>
      <li class="flex items-center space-x-6 py-[16px] pl-[30px] text-left">
        <svg class="icon">
          <use xlink:href="/icons/defs/svg/sprite.css.svg#dashboard"></use>
        </svg>
        <p class="hidden lap:block text-button_orange">Dashboard</p>
      </li>
      <li class="flex items-center space-x-6 py-[16px] pl-[30px] text-left">
        <svg class="icon">
          <use xlink:href="/icons/defs/svg/sprite.css.svg#recruitment"></use>
        </svg>
        <p class="hidden lap:block">Recruitment</p>
      </li>
      <li class="flex items-center space-x-6 py-[16px] pl-[30px] text-left">
        <svg class="icon">
          <use xlink:href="/icons/defs/svg/sprite.css.svg#schedule"></use>
        </svg>
        <p class="hidden lap:block">Schedule</p>
      </li>
      <li class="flex items-center space-x-6 py-[16px] pl-[30px] text-left">
        <svg class="icon">
          <use xlink:href="/icons/defs/svg/sprite.css.svg#employee"></use>
        </svg>
        <p class="hidden lap:block">Employee</p>
      </li>
      <li class="flex items-center space-x-6 py-[16px] pl-[30px] text-left">
        <svg class="icon">
          <use xlink:href="/icons/defs/svg/sprite.css.svg#department"></use>
        </svg>
        <p class="hidden lap:block">Department</p>
      </li>
    </ul>
    <ul class="lap:w-[242px] tab:w-[90px]">
      <li
        class="font-roboto font-medium-12 opacity-50 py-[10px] lap:pl-[30px] lap:text-left tab:text-center text-[12px] text-grey_text"
      >
        <p class="lap:w-[242px] tab:w-[90px]">OTHER</p>
      </li>
      <li class="flex items-center space-x-6 py-[16px] pl-[30px] text-left">
        <svg class="icon">
          <use xlink:href="/icons/defs/svg/sprite.css.svg#support"></use>
        </svg>
        <p class="hidden lap:block">Support</p>
      </li>
      <li class="flex items-center space-x-6 py-[16px] pl-[30px] text-left">
        <svg class="icon">
          <use xlink:href="/icons/defs/svg/sprite.css.svg#settings"></use>
        </svg>
        <p class="hidden lap:block">Settings</p>
      </li>
    </ul>
  </div>

  <!-- right part-->
  <div class="w-full">
    <!-- header-->
    <div
      class="w-full border ph:h-[60px] tab:h-[62px] lap:h-[91px] ph:px-[20px] tab:px-[50px] py-[17.5px] flex justify-between items-center"
    >
      <div class="flex ph:space-x-4 tab:space-x-4 lap:space-x-0 items-center">
        <svg class="icon lap:hidden">
          <use xlink:href="/icons/defs/svg/sprite.css.svg#menu"></use>
        </svg>

        <div
          class="flex justify-between items-center lap:h-[44px] tab:h-[36px] lap:w-[343px] tab:w-[245px] font-poppins font-regular text-4 tab:border lap:border tab:py-[10px] tab:px-4 lap:py-[10px] lap:px-4 text-[#B3B3B3] tab:bg-[#FAFAFA] lap:bg-[#FAFAFA] rounded"
        >
          <p class="hidden tab:block lap:block">Search</p>
          <svg class="icon">
            <use xlink:href="/icons/defs/svg/sprite.css.svg#search"></use>
          </svg>
        </div>
      </div>

      <div
        class="ph:w-[146px] ph:h-[42px] tab:w-[223px] tab:h-[61px] lap:w-[364px] lap:h-[90px] ph:space-x-4 tab:space-x-[30px] justify-end text-white flex items-center"
      >
        <svg class="icon">
          <use xlink:href="/icons/defs/svg/sprite.css.svg#notifications"></use>
        </svg>

        <svg class="icon">
          <use xlink:href="/icons/defs/svg/sprite.css.svg#messages"></use>
        </svg>

        <div
          class="flex items-center ph:space-x-[6px] tab:space-x-[12px] ph:w-[66px] h-[42px] tab:w-[68px] lap:w-[193px]"
        >
          <img src="/images/photo.png" class="size-9 lap:size-[42px]" />

          <div class="flex items-center">
            <p
              class="hidden lap:block text-deftext font-poppins font-medium text-[16px]"
            >
              Admirra John
            </p>
            <svg class="icon">
              <use xlink:href="/icons/defs/svg/sprite.css.svg#arrow_down"></use>
            </svg>
          </div>
        </div>
      </div>
    </div>

    <div class="ph:px-5 tab:px-14 text-deftext">
      <div class="grid py-[10px] h-[62px] space-y-5">
        <!-- 1 -->
        <div
          class="flex items-center font-poppins text-left text-[20px] font-medium py-3 rounded -mb-5"
        >
          Dashboard
        </div>
        <!-- two cols -->
        <div
          class="grid tab:grid-cols-1 ph:grid-cols-1 lap:grid-cols-[60%,40%] lap:space-x-4 ph:space-y-5 tab:space-y-5 lap:space-y-0"
        >
          <div class="flex flex-col space-y-5">
            <div class="grid grid-cols-1">
              <div
                class="grid ph:grid-cols-1 tab:grid-cols-3 lap:grid-cols-3 tab:space-x-4 lap:space-x-4 ph:space-y-5 tab:space-y-0 lap:space-y-0"
              >
                <!-- 2 -->
                <div
                  class="bg-[#FFEFE7] pl-5 pr-3 border text-left rounded-xl flex flex-col justify-center break-words"
                >
                  <p class="font-medium font-poppins mt-3">
                    Available Position
                  </p>
                  <p
                    class="flex items-center font-medium font-poppins text-[32px] my-4"
                  >
                    24
                  </p>
                  <p class="text-button_orange font-roboto mb-3">
                    4 Urgently needed
                  </p>
                </div>

                <!-- 3 -->
                <div
                  class="bg-[#E8F0FB] pl-5 pr-3 border text-left rounded-xl flex flex-col justify-center break-words"
                >
                  <p class="font-medium font-poppins mt-3">Job Open</p>
                  <p
                    class="flex items-center font-medium font-poppins text-[32px] my-4"
                  >
                    10
                  </p>
                  <p class="text-[#3786F1] font-roboto mb-3">4 Active hiring</p>
                </div>

                <!-- 4 -->
                <div
                  class="bg-[#FDEBF9] ph:pl-5 ph:pr-3 border text-left rounded-xl flex flex-col justify-center break-words"
                >
                  <p class="font-medium font-poppins mt-3">New Employees</p>
                  <p
                    class="flex items-center font-medium font-poppins text-[32px] my-4"
                  >
                    24
                  </p>
                  <p class="text-[#EE61CF] font-roboto mb-3">4 Department</p>
                </div>
              </div>
            </div>

            <div
              class="grid ph:grid-cols-1 tab:grid-cols-2 lap:grid-cols-2 ph:space-x-0 tab:space-x-3 lap:space-x-3 ph:space-y-5 tab:space-y-0 lap:space-y-0"
            >
              <!--  5 -->
              <div
                class="px-5 flex justify-between border items-center text-left rounded-xl"
              >
                <div class="flex flex-col items-left space-y-8">
                  <div class="flex flex-col items-left pt-5 space-y-[22px]">
                    <div class="font-poppins font-medium text-4">
                      Total Employees
                    </div>
                    <div
                      class="flex items-center font-poppins font-medium text-[42px] h-7"
                    >
                      216
                    </div>
                  </div>
                  <div
