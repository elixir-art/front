              >
                <p class="m-0 h-5">See All Announcements</p>
              </button>
            </div>
          </div>

          <div
            class="grid ph:grid-cols-1 tab:grid-cols-[40%,60%] lap:grid-cols-1 ph:space-y-5 tab:space-y-0 lap:space-y-5 tab:space-x-5 lap:space-x-0 ph:pb-10 tab:pb-16 lap:pb-10"
          >
            <!--  8 -->
            <div class="text-center border bg-blue_back rounded-xl tab:w-[1/5]">
              <div class="flex justify-between items-center p-5">
                <div class="font-poppins font-medium text-[16px] text-white">
