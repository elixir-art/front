                    position
                  </p>
                  <div class="flex justify-between items-center">
                    <p
                      class="font-roboto font-regular text-[10px] text-grey_text"
                    >
                      Yesterday, 09:15 AM
                    </p>
                    <div class="flex justify-between space-x-2">
                      <svg class="icon text-grey_pin">
                        <use
                          xlink:href="/icons/defs/svg/sprite.css.svg#pin"
                        ></use>
                      </svg>
                      <svg class="icon">
                        <use
                          xlink:href="/icons/defs/svg/sprite.css.svg#three_dots"
                        ></use>
                      </svg>
                    </div>
                  </div>
                </div>
              </div>

              <button
