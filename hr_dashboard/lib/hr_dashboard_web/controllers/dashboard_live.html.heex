                <div class="border rounded-md mb-2 px-3 py-2 bg-grey_bg">
                  <p
                    class="flex justify-left font-poppins font-regular text-[14px] text-second_title text-left"
                  >
                    Review candidate applications
                  </p>
                  <div class="flex justify-between items-center">
                    <p
                      class="font-roboto font-regular text-[10px] text-grey_text"
