                    <div class="flex justify-between space-x-2">
                      <svg class="icon text-grey_pin">
                        <use
                          xlink:href="/icons/defs/svg/sprite.css.svg#pin"
                        ></use>
                      </svg>
                      <svg class="icon">
                        <use
                          xlink:href="/icons/defs/svg/sprite.css.svg#three_dots"
                        ></use>
                      </svg>
                    </div>
                  </div>
                </div>

                <div class="border rounded-md mb-2 px-3 py-2 bg-grey_bg">
                  <p
                    class="text-left font-poppins font-regular text-[14px] text-second_title"
                  >
