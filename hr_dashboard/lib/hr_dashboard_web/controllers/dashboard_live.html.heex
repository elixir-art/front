                  >
                    <div class="h-[18px]">120 Men</div>
                    <div class="h-[18px]">96 Women</div>
                  </div>
                </div>

                <div class="flex flex-col space-y-5">
                  <div class="flex-col justify-center">
                    <img
                      src="/images/two_percents_graph.png"
                      class="text-center w-[115px] h-[78x]"
                    />
                  </div>
                  <div
                    class="font-roboto font-regular text-[#303030] flex items-center justify-center text-[12px] bg-[#FFEFE7] h-6"
                  >
                    +2% Past month
                  </div>
                </div>
              </div>

              <!--  6 -->
              <div
                class="px-5 flex justify-between border items-center text-left rounded-xl"
              >
                <div class="flex flex-col items-left space-y-8">
                  <div class="flex flex-col items-left pt-5 space-y-[22px]">
                    <div class="font-poppins font-medium text-4">
                      Talent Request
                    </div>
                    <div
                      class="flex items-center font-poppins font-medium text-[42px] h-7"
                    >
                      16
                    </div>
                  </div>
                  <div
                    class="font-roboto font-regular text-[12px] text-grey_text pb-5 space-y-1"
                  >
                    <div class="h-[18px]">6 Men</div>
                    <div class="h-[18px]">10 Women</div>
                  </div>
                </div>

                <div class="flex flex-col space-y-5">
                  <div class="flex-col justify-center">
                    <img
                      src="/images/five_percents_graph.png"
