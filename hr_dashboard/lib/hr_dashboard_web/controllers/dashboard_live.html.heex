                    />
                  </div>
                  <div
                    class="font-roboto font-regular text-[#303030] flex items-center justify-center text-[12px] bg-[#FFEFE7] h-6"
                  >
                    +5% Past month
                  </div>
                </div>
              </div>
            </div>

            <!--  7 -->
            <div class="overflow-hidden text-center border rounded-xl">
              <div class="flex justify-between items-center p-5">
                <div class="font-poppins font-medium text-[16px]">
