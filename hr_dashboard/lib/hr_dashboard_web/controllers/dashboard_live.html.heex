                      <svg class="icon">
                        <use
                          xlink:href="/icons/defs/svg/sprite.css.svg#three_dots"
                        ></use>
                      </svg>
                    </div>
                  </div>
                </div>

                <div class="border rounded-md mb-2 px-3 py-2 bg-grey_bg">
                  <p
                    class="flex justify-left font-poppins font-regular text-[14px] text-second_title"
                  >
                    Meeting HR Departement
                  </p>
                  <div class="flex justify-between items-center">
                    <p
                      class="font-roboto font-regular text-[10px] text-grey_text"
