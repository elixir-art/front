                </div>
                <div
                  class="border rounded flex items-center justify-center h-[22px] p-[6px] font-roboto font-regular ph:text-[10px] tab:text-[12px] text-grey_text"
                >
                  <p class="">Today, 13 Sep 2021</p>
                  <svg class="icon">
                    <use
                      xlink:href="/icons/defs/svg/sprite.css.svg#arrow_down"
                    ></use>
                  </svg>
