<div class="grid gris-cols-1 lg:grid-cols-2">
  <div class="grid grid-cols-1">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <div class="bg-red-50 rounded-xl p-6">
        <h3 class="text-lg font-medium text-gray-900">Available Position</h3>
        <p class="text-3xl font-bold mt-2 text-gray-900">24</p>
        <p class="text-sm text-red-500 mt-1">4 Urgently needed</p>
      </div>

      <div class="bg-blue-50 rounded-xl p-6">
        <h3 class="text-lg font-medium text-gray-900">Job Open</h3>
        <p class="text-3xl font-bold mt-2 text-gray-900">10</p>
        <p class="text-sm text-blue-500 mt-1">4 Active hiring</p>
      </div>
      <div class="bg-purple-50 rounded-xl p-6">
        <h3 class="text-lg font-medium text-gray-900">New Employees</h3>
        <p class="text-3xl font-bold mt-2 text-gray-900">24</p>
        <p class="text-sm text-purple-500 mt-1">4 Department</p>
      </div>
    </div>
    <div class="grid grid-rows-1 md:grid-cols-2 gap-6 mt-8">
      <div class="bg-white rounded-xl p-6 border-2 grid grid-cols-2">
      <div>
        <h3 class="text-lg font-medium text-gray-900">Total Employees</h3>
        <p class="text-3xl font-bold mt-2">216</p>
        <div class="flex justify-between text-sm text-gray-500 mt-2 grid grid-rows-2">
          <span>120 Men</span>
          <span>96 Women</span>
        </div>
        <p class="text-sm text-green-500 mt-1">+2% Past month</p>
      </div>
      <div class="w-24 h-24 flex">
        <img src="/images/total_employees.png" class="w-24 h-24 mt-4">
      </div>
      </div>

      <div class="bg-white rounded-xl p-6 border-2 grid grid-cols-2">
      <div>
        <h3 class="text-lg font-medium text-gray-900">Talent Request</h3>
        <p class="text-3xl font-bold mt-2">16</p>
        <div class="flex justify-between text-sm text-gray-500 mt-2 grid grid-rows-2">
          <span>5 Men</span>
          <span>11 Women</span>
        </div>
