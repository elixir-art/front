  <div class="flex border border-gray-200 items-center">
    <div class="flex mr-auto ml-5">
      <svg class="size-10 cursor-pointer mt-8">
        <use xlink:href="#lines"></use>
      </svg>
      <svg class="size-10 cursor-pointer mt-[26px]">
        <use xlink:href="#search"></use>
      </svg>
    </div>
    <div class="flex ml-auto">
      <svg class="size-10 cursor-pointer mt-6">
        <use xlink:href="#notification"></use>
      </svg>
      <svg class="size-10 cursor-pointer mt-6">
        <use xlink:href="#message"></use>
      </svg>
      <svg class="size-10 cursor-pointer mt-4">
        <use xlink:href="#avatar"></use>
      </svg>
      <svg class="size-10 cursor-pointer mt-8 ml-[6px]">
        <use xlink:href="#down"></use>
      </svg>
    </div>
  </div>

  <div class="p-5">
    <p class="text-[20px] text-dark-blue font-medium mb-[10px]">Dashboard</p>
    <div class=" bg-light-red p-4 mb-4 mt-2 rounded-md">
      <p class="text-dark-blue font-medium mt-2 ml-2">Available Position</p>
      <p class="text-4xl text-dark-blue font-medium mt-2 ml-2">24</p>
      <p class="text-sm text-red mt-2 ml-2">4 Urgently needed</p>
    </div>
    <div class=" bg-light-blue p-4 mb-4 rounded-md">
      <p class="text-dark-blue font-medium mt-2 ml-2">Job Open</p>
      <p class="text-4xl text-dark-blue font-medium mt-2 ml-2">10</p>
      <p class="text-sm text-blue mt-2 ml-2">4 Urgently needed</p>
    </div>
    <div class=" bg-light-magenta p-4 mb-4 rounded-md">
      <p class="text-dark-blue font-medium mt-2 ml-2">Available Position</p>
      <p class="text-4xl text-dark-blue font-medium mt-2 ml-2">24</p>
      <p class="text-sm text-magenta mt-2 ml-2">4 Urgently needed</p>
    </div>
    <div class="p-4 mb-4 border border-gray-300 rounded-md">
      <div class="flex justify-between">
        <div>
          <p class="text-dark-blue font-medium mt-2 ml-2">Total Employees</p>
          <p class="text-4xl text-dark-blue font-medium mt-2 ml-2">216</p>
          <p class="text-sm text-gray-500 mt-6 ml-2">120 Men</p>
          <p class="text-sm text-gray-500 mt-2 ml-2">96 Women</p>
        </div>
        <div class="text-right mt-4 mr-3">
          <img
            src="/images/first_graph.png"
            alt="First Graph"
            width="115"
            height="87"
            class="ml-auto"
          />
          <p class="text-sm text-gray-600 bg-light-red mt-3">+2% Past month</p>
        </div>
      </div>
    </div>
    <div class="p-4 mb-4 border border-gray-300 rounded-md">
      <div class="flex justify-between">
        <div>
          <p class="text-dark-blue font-medium mt-2 ml-2">Talent Request</p>
          <p class="text-4xl text-dark-blue font-medium mt-2 ml-2">16</p>
          <p class="text-sm text-gray-500 mt-6 ml-2">6 Men</p>
          <p class="text-sm text-gray-500 mt-2 ml-2">10 Women</p>
        </div>
        <div class="text-right mt-4 mr-3">
          <img
            src="/images/second_graph.png"
            alt="Second Graph"
            width="115"
            height="87"
            class="ml-auto"
          />
          <p class="text-sm text-gray-600 bg-light-red mt-3">+5% Past month</p>
        </div>
      </div>
    </div>
    <div class="mb-4 border border-gray-300 rounded-md">
      <div class="flex items-center">
        <div class="flex mr-auto mt-2 ml-2">
          <p class="text-dark-blue font-medium mt-2 ml-3">Announcement</p>
        </div>
        <div class="flex items-center text-[10px] text-gray-500 border border-gray-400 px-2 py-1 mt-4 mr-4 leading-none">
          <span>Today, 13 Sep 2021</span>
          <svg class="ml-2 size-4 cursor-pointer"> 
            <use xlink:href="#second_down"></use>
          </svg>
        </div>
      </div>
      <div class="m-4 mt-4 bg-gray-700 border border-gray-300 rounded-md">
        <p class="text-[15px] text-gray-600 font-normal mt-3 ml-4">
          Outing schedule for every departement
        </p>
        <div class="flex items-center">
          <div class="flex mr-auto">
            <p class="text-[10px] text-gray-500 font-light ml-[17px]">5 Minutes ago</p>
          </div>
          <div class="flex items-center text-[10px] mt-1 mr-3">
            <svg class="size-6 cursor-pointer">
              <use xlink:href="#pin"></use>
            </svg>
            <svg class="size-6 cursor-pointer ml-[6px] mt-[19px]">
              <use xlink:href="#dots"></use>
            </svg> 
          </div>
        </div>
      </div>
      <div class="m-4 mt-3 bg-gray-700 border border-gray-300 rounded-md">
        <p class="text-[15px] text-gray-600 font-normal mt-3 ml-4">
          Meeting HR Department
        </p>
        <div class="flex items-center">
          <div class="flex mr-auto">
            <p class="text-[10px] text-gray-500 font-light mt-[10px] ml-[17px]">Yesterday, 12:30 PM</p>
          </div>
          <div class="flex items-center text-[10px] mt-1 mr-3">
            <svg class="size-6 cursor-pointer">
              <use xlink:href="#disabled_pin"></use>
            </svg> 
            <svg class="size-6 cursor-pointer ml-[6px] mt-[19px]">
              <use xlink:href="#dots"></use>
            </svg>
          </div>
        </div>
      </div>
      <div class="m-4 mt-4 bg-gray-700 border border-gray-300 rounded-md"> 
        <p class="text-[15px] text-gray-600 font-normal mt-3 ml-4">IT Department need two more talents for UX/UI Designer position</p>
        <div class="flex items-center"> 
          <div class="flex mr-auto">
            <p class="text-[10px] text-gray-500 font-light mt-[2px] ml-[17px]">Yesterday, 09:15 AM</p>
          </div>
          <div class="flex items-center text-[10px] mt-1 mr-3"> 
            <svg class="size-6 cursor-pointer"> 
              <use xlink:href="#disabled_pin"></use> 
            </svg> 
            <svg class="size-6 cursor-pointer ml-[6px] mt-[19px]">
              <use xlink:href="#dots"></use>
            </svg>
          </div>   
        </div> 
      </div>
      <button class="mb-[10px] pt-[10px] w-full border-t border-gray-300 text-red text-center text-[15px] text-gray-red font-normal">
        See All Announcement
      </button>
    </div>
  </div>
</main>
